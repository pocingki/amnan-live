# Salin berkas ini menjadi .env lalu isi nilainya:  cp .env.example .env
# Baris yang diawali # adalah komentar. Jangan commit .env ke git.

# ---------- Login dashboard ----------
# Nama pengguna admin pertama (bawaan: admin).
DASHBOARD_USER=admin
# Kata sandi admin pertama (teks biasa). WAJIB diisi kecuali ALLOW_NO_AUTH=1.
# Disarankan minimal 12 karakter. Untuk akun tambahan / peran agent pakai: npm run users
DASHBOARD_PASSWORD=
# Alternatif yang lebih aman daripada DASHBOARD_PASSWORD: hash kata sandi.
# Buat hash dengan skrip pengguna (npm run users) lalu tempel di sini; kosongkan DASHBOARD_PASSWORD.
DASHBOARD_PASSWORD_HASH=

# ---------- Server ----------
# Port HTTP dashboard (bawaan 8080).
PORT=8080
# Alamat yang didengarkan. Bawaan 127.0.0.1: akses dari luar hanya lewat reverse proxy.
# Isi 0.0.0.0 hanya di dalam kontainer (docker-compose sudah mempublikasikan port ke 127.0.0.1 host).
BIND_HOST=127.0.0.1
# Folder data (leads, percakapan, pengaturan, media, sesi WhatsApp di data/auth, database SQLite).
# Di Docker diisi /data. JANGAN hapus folder auth (sesi WhatsApp).
DATA_DIR=./data
# Folder aplikasi yang berisi public/ dan config/ (bawaan: folder kerja saat npm start). Biasanya dibiarkan kosong.
APP_DIR=
# Kunci enkripsi data tersimpan (opsional; database DAN berkas JSON seperti pengguna, pengaturan, rahasia webhook). Isi 32 byte acak dalam hex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Simpan salinan kunci di tempat terpisah dari backup. Kunci hilang = data terenkripsi tidak bisa dibuka.
DATA_KEY=
# Percayai header X-Forwarded-For / X-Forwarded-Proto dari reverse proxy.
# Isi 1 HANYA bila server berada di belakang ngrok, Cloudflare Tunnel, nginx, dsb.
# Bila 0/kosong, IP klien diambil dari koneksi langsung (header palsu diabaikan).
TRUST_PROXY=0
# Zona waktu (bawaan Asia/Jakarta).
TZ=Asia/Jakarta

# ---------- Mode khusus (jangan dipakai di produksi) ----------
# 1 = izinkan dashboard tanpa password. HANYA untuk uji lokal di komputer sendiri.
ALLOW_NO_AUTH=0
# 1 = bot membalas tanpa jeda "mengetik". Dipakai oleh tes otomatis.
BOT_NO_DELAY=0

# ---------- Instance per client (docs/MULTI-CLIENT.md) ----------
# Dibuat otomatis oleh: node scripts/client.js new <slug> ...  Untuk instalasi tunggal boleh dikosongkan.
# Pengenal singkat client (huruf kecil/angka/-), tampil di log server. Tidak dibuka ke publik (/healthz tetap minimal).
CLIENT_ID=
# Nama dan tagline awal di dashboard; hanya dipakai saat pengaturan belum pernah disimpan.
BRAND_NAME=
BRAND_TAGLINE=
# Warna utama brand (#RRGGBB, harus cukup gelap untuk teks putih); kosong = biru bawaan.
# Logo dan favicon diunggah dari dashboard: Pengaturan > Bot & brand.
BRAND_COLOR=
# Path file .env ini bila kode dijalankan dari folder bersama (diisi oleh pm2, bukan di dalam .env).
# ENV_FILE=/opt/clients/<slug>/.env
# File kata kunci khusus client (bawaan: config/keywords.json di folder kode).
# KEYWORDS_FILE=/opt/clients/<slug>/keywords.json