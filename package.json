{
  "name": "amnan-live",
  "version": "0.2.0",
  "private": true,
  "description": "Amnan SaaS - dashboard CRM + bot balas otomatis WhatsApp (Baileys) untuk klinik fisioterapi acesio",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "lint": "eslint .",
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.input.css -o public/assets/css/tailwind.css --minify",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "users": "node scripts/users.js",
    "smoke": "node scripts/smoke.js",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "better-sqlite3": "^12.0.0",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "tailwindcss": "^3.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
